---
import Layout from "./main.astro"
---

<Layout>
  <div class="bg-card text-card-foreground border-b border-olive-200">
    <header class="md:flex items-center justify-between container py-4">
      <a href="/" class="font-bold">
        Clarity SLT
      </a>
      <nav class="flex flex-wrap gap-4">
        <a href="/#team">Our Team</a>
        <a href="/#services">Our Services</a>
        <a href="/#faq">FAQ</a>
        <a href="/#contact">Contact Us</a>
      </nav>
    </header>
  </div>
  <main class="flex-1 my-8">
    <slot />
  </main>
  <footer class="bg-accent text-accent-foreground py-8">
    <div class="container">
      <nav class="flex flex-col gap-2">
        <a href="/#team">Our Team</a>
        <a href="/#services">Our Services</a>
        <a href="/#faq">FAQ</a>
        <a href="/#contact">Contact Us</a>
      </nav>
    </div>
  </footer>
</Layout>
